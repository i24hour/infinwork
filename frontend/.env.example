# Copy to .env.local for local runs. Never commit real secrets.

# --- Rank Politician: scraping ---
# Jina Reader is the free primary provider. An API key raises rate limits.
JINA_API_KEY=
# Firecrawl is an optional paid fallback, used only when Jina returns 0 posts.
FIRECRAWL_API_KEY=

# --- Rank Politician: LLM classification (LiteLLM-compatible) ---
# Preferred: AWS Bedrock API key (bearer token) for Kimi K2.5
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION_NAME=us-east-1
LLM_MODEL=moonshotai.kimi-k2.5

# Optional: route through a LiteLLM proxy instead of Bedrock Mantle directly
# Include /v1 so the OpenAI SDK calls /chat/completions correctly:
# LITELLM_BASE_URL=http://localhost:4000/v1
# LITELLM_API_KEY=sk-...

# Optional overrides
# BEDROCK_MANTLE_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
# LLM_TIMEOUT_MS=45000

# --- App ---
MONGODB_URI=
CRON_SECRET=
# Optional: restrict the one-time "Claim first admin" action to this address.
# ADMIN_BOOTSTRAP_EMAIL=you@example.com
# NEXTAUTH_SECRET (or AUTH_SECRET) is required in production.
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# --- Auth providers (optional but required for sign-in) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth: both values are required to show/use "Connect GitHub".
# GitHub sync polls every ~2 minutes and counts commits since connection.
# Private contributions appear only if the user enabled "Include private
# contributions on my profile" in GitHub settings (read:user scope).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: server-side GitHub GraphQL token for profile contribution calendars
# GITHUB_TOKEN=

# --- Local dev only: demo credentials provider ---
# NEVER enable in production: it accepts any email+password with no verification.
# ALLOW_DEMO_CREDENTIALS=true
# NEXT_PUBLIC_ALLOW_DEMO_CREDENTIALS=true
